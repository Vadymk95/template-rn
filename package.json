{
    "name": "template-rn",
    "version": "0.3.7",
    "private": true,
    "main": "expo-router/entry",
    "engines": {
        "node": ">=24.14.1",
        "npm": ">=11.10.0"
    },
    "scripts": {
        "start": "expo start --go",
        "start:clear": "expo start --clear --go",
        "start:tunnel": "expo start --tunnel ngrok --go",
        "start:tunnel:clear": "expo start --tunnel ngrok --clear --go",
        "start:devclient": "expo start",
        "start:devclient:clear": "expo start --clear",
        "ios": "expo start --ios --go",
        "android": "expo start --android --go",
        "ios:dev": "expo start --ios",
        "android:dev": "expo start --android",
        "prebuild": "expo prebuild --clean",
        "prebuild:preview": "APP_VARIANT=preview expo prebuild --clean",
        "doctor": "expo-doctor",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix --cache --cache-location .eslintcache",
        "lint:oxlint": "oxlint --config .oxlintrc.json --deny-warnings src",
        "fix": "oxlint --config .oxlintrc.json --fix src && eslint . --fix --cache --cache-location .eslintcache && prettier --write .",
        "format": "prettier --write . --cache --cache-location .prettiercache",
        "format:check": "prettier --check . --cache --cache-location .prettiercache",
        "audit:gate": "node scripts/audit-gate.mjs",
        "lock:age": "node scripts/check-lock-age.mjs",
        "gate:integrity": "node scripts/check-gate-integrity.mjs",
        "verify": "node scripts/gate-trace.mjs verify -- npm run verify:inner",
        "verify:iter": "node scripts/gate-trace.mjs verify:iter -- npm run verify:iter:inner",
        "verify:ci": "node scripts/gate-trace.mjs verify:ci -- npm run verify:ci:inner",
        "verify:native": "npm run verify && npm run doctor",
        "verify:rc": "react-compiler-healthcheck src",
        "bench:verify": "node scripts/bench-verify.mjs",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "node scripts/check-coverage.mjs",
        "test:mutation": "stryker run",
        "test:coverage:raw": "jest --coverage",
        "test:scripts": "node scripts/test-scripts.mjs",
        "bundle:analyze": "EXPO_ATLAS=1 expo export --platform ios --output-dir .atlas",
        "bundle:analyze:android": "EXPO_ATLAS=1 expo export --platform android --output-dir .atlas-android",
        "perf:capture": "node scripts/capture-bundle-metrics.mjs --export",
        "perf:capture:all": "node scripts/capture-bundle-metrics.mjs --export --platform all",
        "perf:measure": "node scripts/capture-bundle-metrics.mjs",
        "perf:baseline": "node scripts/capture-bundle-metrics.mjs --export --platform all --write-baseline",
        "perf:check": "node scripts/capture-bundle-metrics.mjs --export --platform all --check",
        "ci:local": "npm run verify:ci && npm run doctor",
        "maestro": "maestro test .maestro",
        "prepare": "husky",
        "verify:inner": "node scripts/check-hooks.mjs && node scripts/check-version-holds.mjs && node scripts/check-engines-floor.mjs && node scripts/check-test-siblings.mjs --range && node scripts/docs-check.mjs && npm run lint:oxlint && npm run format:check && npm run typecheck && npm run lint && npm run test:scripts && npm run test:coverage",
        "verify:iter:inner": "node scripts/check-hooks.mjs && npm run lint:oxlint && npm run typecheck && node scripts/lint-changed.mjs && node scripts/check-test-siblings.mjs --changed && node scripts/format-changed.mjs && node scripts/docs-trigger.mjs && node scripts/iterate-tests.mjs && node scripts/mutation-scope.test.mjs",
        "verify:ci:inner": "npm run audit:gate && npm run lock:age && npm run verify",
        "trace:report": "node scripts/trace-report.mjs",
        "test:one": "node scripts/gate-trace.mjs test:one -- npx --no-install jest",
        "docs:check": "node scripts/gate-trace.mjs docs:check -- node scripts/docs-check.mjs",
        "fork:init": "node scripts/fork-init.mjs"
    },
    "dependencies": {
        "@expo/vector-icons": "^15.1.1",
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@t3-oss/env-core": "^0.13.11",
        "@tanstack/react-query": "^5.108.2",
        "babel-preset-expo": "~58.0.0",
        "clsx": "^2.1.1",
        "expo": "~58.0.25",
        "expo-constants": "~58.0.16",
        "expo-dev-client": "~58.0.20",
        "expo-font": "~58.0.12",
        "expo-linking": "~58.0.17",
        "expo-localization": "~58.0.5",
        "expo-router": "~58.0.31",
        "expo-secure-store": "~58.0.3",
        "expo-splash-screen": "~58.0.14",
        "expo-status-bar": "~58.0.5",
        "expo-system-ui": "~58.0.7",
        "expo-updates": "~58.0.22",
        "i18next": "^26.5.12",
        "nativewind": "^4.2.7",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hook-form": "^7.92.0",
        "react-i18next": "^17.1.9",
        "react-native": "0.88.1",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.11.1",
        "react-native-screens": "~4.30.1",
        "react-native-web": "^0.21.4",
        "react-native-worklets": "0.13.0",
        "zod": "^4.6.7",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
        "@eslint/js": "^10.0.1",
        "@expo/ngrok": "^4.1.3",
        "@hookform/resolvers": "^7.0.6",
        "@stryker-mutator/core": "^10.1.1",
        "@stryker-mutator/jest-runner": "^10.1.1",
        "@tanstack/eslint-plugin-query": "^5.108.2",
        "@testing-library/react-native": "^14.1.0",
        "@types/jest": "^30.0.0",
        "@types/react": "~19.3.0",
        "babel-plugin-transform-remove-console": "^6.9.4",
        "eslint": "^10.14.0",
        "eslint-config-expo": "~58.0.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.4.4",
        "eslint-plugin-i18next": "^6.1.5",
        "eslint-plugin-import-x": "^4.18.1",
        "eslint-plugin-jest": "^29.17.1",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-web-api": "5.30.5",
        "expo-atlas": "^0.5.0",
        "expo-doctor": "^1.20.1",
        "husky": "^9.1.7",
        "jest": "~30.5.2",
        "jest-expo": "~58.0.14",
        "lint-staged": "^17.6.1",
        "oxlint": "~1.94.0",
        "prettier": "^3.10.1",
        "react-compiler-healthcheck": "^1.0.0",
        "tailwindcss": "^3.4.19",
        "test-renderer": "~1.3.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.73.0",
        "yaml": "^2.9.1"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,mjs,cjs}": [
            "oxlint --config .oxlintrc.json --fix --no-error-on-unmatched-pattern",
            "eslint --fix --no-warn-ignored --cache --cache-location .eslintcache",
            "prettier --write --cache --cache-location .prettiercache"
        ],
        "*.{json,md,yml,yaml,css}": [
            "prettier --write --cache --cache-location .prettiercache"
        ]
    },
    "jest": {
        "preset": "jest-expo",
        "testMatch": [
            "**/__tests__/**/*.[jt]s?(x)",
            "**/?(*.)+(spec|test).[jt]s?(x)"
        ],
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/\\.claude/worktrees/"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        },
        "setupFilesAfterEnv": [
            "<rootDir>/src/test/setup.ts"
        ],
        "collectCoverageFrom": [
            "src/**/*.{ts,tsx}",
            "!src/**/*.d.ts",
            "!src/**/index.ts",
            "!src/test/**",
            "!src/app/**",
            "!src/env.ts",
            "!src/shared/lib/constants/**",
            "!src/shared/lib/i18n/**",
            "!src/shared/locales/**",
            "!src/**/*.stories.{ts,tsx}",
            "!src/lib/api/_example*"
        ],
        "coverageReporters": [
            "json",
            "text-summary",
            "lcov",
            "clover"
        ],
        "coverageThreshold": {
            "global": {
                "statements": 80,
                "branches": 60,
                "functions": 80,
                "lines": 80
            }
        },
        "transformIgnorePatterns": [
            "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|nativewind|react-native-css-interop|react-native-reanimated|react-native-worklets))"
        ]
    },
    "overrides": {
        "react-dom": "19.3.0",
        "uuid": ">=11.1.1 <15",
        "brace-expansion": ">=5.0.12 <6",
        "fast-uri": ">=4.1.2 <5",
        "handlebars": ">=4.7.10 <5",
        "node-forge": ">=1.4.1 <2",
        "eslint-plugin-react": {
            "eslint": "$eslint"
        },
        "eslint-plugin-import": {
            "eslint": "$eslint"
        },
        "expo-router": {
            "nanoid": ">=3.3.18 <4"
        },
        "js-yaml@^3": ">=3.15.1 <4",
        "js-yaml@^4": ">=4.3.1 <5",
        "postcss": {
            "nanoid": ">=3.3.18 <4"
        }
    }
}
