{
    "name": "template-rn",
    "version": "0.1.0",
    "private": true,
    "main": "expo-router/entry",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "start": "expo start --go",
        "start:clear": "expo start --clear --go",
        "start:tunnel": "expo start --tunnel --go",
        "start:tunnel:clear": "expo start --tunnel --clear --go",
        "start:devclient": "expo start",
        "start:devclient:clear": "expo start --clear",
        "ios": "expo start --ios --go",
        "android": "expo start --android --go",
        "ios:dev": "expo start --ios",
        "android:dev": "expo start --android",
        "prebuild": "expo prebuild --clean",
        "prebuild:preview": "APP_VARIANT=preview expo prebuild --clean",
        "doctor": "expo-doctor",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "lint:oxlint": "oxlint --config .oxlintrc.json --deny-warnings src",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "verify": "npm run typecheck && npm run lint:oxlint && npm run lint && npm run format:check && npm run test:coverage",
        "verify:native": "npm run verify && npm run doctor",
        "verify:rc": "react-compiler-healthcheck src",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "bundle:analyze": "EXPO_ATLAS=1 expo export --platform ios --output-dir .atlas",
        "bundle:analyze:android": "EXPO_ATLAS=1 expo export --platform android --output-dir .atlas-android",
        "perf:capture": "node scripts/capture-bundle-metrics.mjs --export",
        "perf:capture:all": "node scripts/capture-bundle-metrics.mjs --export --platform all",
        "perf:measure": "node scripts/capture-bundle-metrics.mjs",
        "perf:baseline": "node scripts/capture-bundle-metrics.mjs --export --platform all --write-baseline",
        "perf:check": "node scripts/capture-bundle-metrics.mjs --export --platform all --check",
        "ci:local": "npm run verify:native",
        "maestro": "maestro test .maestro",
        "prepare": "husky"
    },
    "dependencies": {
        "@expo/vector-icons": "^15.1.1",
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@t3-oss/env-core": "^0.13.11",
        "@tanstack/react-query": "^5.101.2",
        "babel-preset-expo": "~57.0.0",
        "clsx": "^2.1.1",
        "expo": "^57.0.6",
        "expo-application": "~57.0.1",
        "expo-constants": "~57.0.5",
        "expo-dev-client": "~57.0.6",
        "expo-device": "~57.0.1",
        "expo-font": "~57.0.1",
        "expo-linking": "~57.0.3",
        "expo-localization": "~57.0.1",
        "expo-router": "~57.0.6",
        "expo-secure-store": "~57.0.1",
        "expo-splash-screen": "~57.0.4",
        "expo-status-bar": "~57.0.1",
        "expo-system-ui": "~57.0.1",
        "expo-updates": "~57.0.7",
        "i18next": "^26.3.6",
        "nativewind": "^4.2.6",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-hook-form": "^7.81.0",
        "react-i18next": "^17.0.10",
        "react-native": "0.86.0",
        "react-native-edge-to-edge": "^1.8.1",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.0",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "4.25.2",
        "react-native-svg": "15.15.4",
        "react-native-web": "^0.21.2",
        "react-native-worklets": "0.10.0",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^9.39.4",
        "@expo/ngrok": "^4.1.3",
        "@hookform/resolvers": "^5.4.0",
        "@tanstack/eslint-plugin-query": "^5.101.2",
        "@testing-library/react-native": "^14.0.1",
        "@types/jest": "^29.5.14",
        "@types/react": "~19.2.15",
        "babel-plugin-transform-remove-console": "^6.9.4",
        "eslint": "^9.39.5",
        "eslint-config-expo": "~57.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.0.2",
        "eslint-plugin-i18next": "^6.1.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jest": "^29.15.4",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-compiler": "^19.1.0-rc.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "expo-atlas": "^0.4.3",
        "expo-doctor": "^1.20.1",
        "husky": "^9.1.7",
        "jest": "~29.7.0",
        "jest-expo": "~57.0.2",
        "lint-staged": "^17.0.8",
        "oxlint": "~1.74.0",
        "prettier": "^3.9.5",
        "react-compiler-healthcheck": "^1.0.0",
        "tailwindcss": "^3.4.19",
        "test-renderer": "~1.2.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.64.0"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "oxlint --config .oxlintrc.json --fix",
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "jest": {
        "preset": "jest-expo",
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        },
        "setupFilesAfterEnv": [
            "<rootDir>/src/test/setup.ts"
        ],
        "collectCoverageFrom": [
            "src/**/*.{ts,tsx}",
            "!src/**/*.d.ts",
            "!src/**/index.ts",
            "!src/test/**",
            "!src/app/**",
            "!src/env.ts",
            "!src/shared/lib/constants/**",
            "!src/shared/lib/i18n/**",
            "!src/shared/locales/**",
            "!src/**/*.stories.{ts,tsx}",
            "!src/lib/api/_example*"
        ],
        "coverageThreshold": {
            "global": {
                "statements": 80,
                "branches": 60,
                "functions": 80,
                "lines": 80
            }
        },
        "transformIgnorePatterns": [
            "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|nativewind|react-native-css-interop|react-native-reanimated|react-native-worklets))"
        ]
    },
    "overrides": {
        "react-dom": "19.2.3",
        "uuid": ">=11.1.1"
    }
}
