#!/usr/bin/env sh
# The CI gate, so a green push predicts a green pipeline. `verify:ci` is the CI gate; its stages are
# in scripts/gate-tiers.json. The harness tests live in gatelaw, so scripts/ holds only the specs that read
# this repository, and every push runs all of them. The steps run through the step runner
# (scripts/bench-verify.mjs), traced as verify:push, the label the push moment expects in
# scripts/gate-tiers.json (a hand-run verify:ci is a row of its own): a red push names the step that failed.
if ! node scripts/gate-trace.mjs verify:push -- node scripts/bench-verify.mjs --run verify:ci; then
    echo ''
    echo '✖ pre-push: verify:ci failed — the pipeline would fail the same way.'
    echo '  Formatting or lint findings:  npm run fix && git add -u'
    echo '  Advisory blocked by the gate: fix the dependency, or add a dated'
    echo '  allowance to scripts/audit-allowlist.json with the reason.'
    echo ''
    exit 1
fi
